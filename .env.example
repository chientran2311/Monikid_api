# Mock Bank API Environment Variables
# Copy this file to .env and fill in values

# Server
PORT=3001
NODE_ENV=development

# API Key for MoniKid app
API_KEY=monikid-mockbank-secret-2024

# OTP Settings (mock)
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
